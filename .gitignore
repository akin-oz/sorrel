# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json

# Build outputs
dist/
build/
.out/
.cache/
.temp/

# Coverage
coverage/
*.lcov

# Env / secrets
.env
.env.*
!.env.example
*.local

# TLS certs — never commit. mkcert locally instead.
*.pem
*-key.pem

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# TypeScript
*.tsbuildinfo

# Logs
logs/
*.log

# Tooling
.sass-cache/
.eslintcache
.turbo/
.lighthouseci/
# Per-workspace lockfiles — only the root yarn.lock is authoritative
apps/*/yarn.lock
packages/*/yarn.lock
services/*/yarn.lock
