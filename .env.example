# Sorrel — env-var template (spec 040 §3)
#
# Copy this file to `.env` at the repo root (apps/web/.env is a symlink to it)
# and fill the values. Build-time keys also need to be set in the Vercel
# Production + Preview environment because Next.js inlines `NEXT_PUBLIC_*`
# values at the moment `yarn build` runs. Runtime keys only need to live in
# the Vercel dashboard.
#
# Real values must NEVER be committed: `.env` is gitignored; this template
# is exempted via `!.env.example` in .gitignore.

# ────────────────────────────────────────────────────────────────────────
# Build-time — must be set when `yarn build` runs (Vercel Production +
# Preview env, and in local `.env` for the local prod-mode `yarn start`).
# Missing keys produce a build that compiles but silently degrades.
# ────────────────────────────────────────────────────────────────────────

# PostHog client SDK ingestion (project key — safe to inline in the bundle).
NEXT_PUBLIC_POSTHOG_KEY=<replace-with-posthog-public-project-key>
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Mixpanel client SDK (token — safe to inline). Optional second sink — when
# this is absent the client falls back to single-vendor (PostHog only).
NEXT_PUBLIC_MIXPANEL_TOKEN=
NEXT_PUBLIC_MIXPANEL_HOST=https://api-eu.mixpanel.com

# Production origin. Scope to **Production only** in the Vercel dashboard —
# leave blank on Preview deploys so RSC GraphQL calls hit the preview's own
# /api/graphql, not production's.
NEXT_PUBLIC_SITE_URL=https://sorrel.example.dev

# Storyblok CDN token for client-side Visual Editor bridge.
NEXT_PUBLIC_STORYBLOK_PUBLIC_TOKEN=

# Stripe publishable key (the only client-side Stripe surface; spec 039).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<replace-with-stripe-publishable-test-key>

# ────────────────────────────────────────────────────────────────────────
# Runtime server-only — Vercel dashboard only, never in the bundle.
# Reading any of these in a "use client" file or via NEXT_PUBLIC_* is a
# security blocker (spec 041 §1).
# ────────────────────────────────────────────────────────────────────────

# PostHog Query API — server-only personal key with `query:read` scope. Reads
# the live funnel for /insights (spec 023). Missing key → static fallback.
POSTHOG_PERSONAL_API_KEY=<replace-with-posthog-personal-api-key>
POSTHOG_PROJECT_ID=<replace-with-posthog-project-id>

# Server-only PostHog host (spec 040 §4). Defaults to https://eu.i.posthog.com.
POSTHOG_HOST=https://eu.i.posthog.com

# Stripe server keys (spec 039). Use a Restricted API Key (`rk_test_…`) over
# a secret key (`sk_test_…`) so blast radius stays at PaymentIntent + webhook.
STRIPE_SECRET_KEY=<replace-with-stripe-restricted-test-key>
STRIPE_WEBHOOK_SECRET=<replace-with-stripe-webhook-signing-secret>

# Storyblok server-side draft + management tokens.
STORYBLOK_PUBLIC_TOKEN=
STORYBLOK_PREVIEW_TOKEN=
STORYBLOK_PREVIEW_SECRET=
STORYBLOK_WEBHOOK_SECRET=
STORYBLOK_PERSONAL_ACCESS_TOKEN=<replace-with-storyblok-personal-access-token>
STORYBLOK_REGION=eu
