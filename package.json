{
  "name": "sorrel-monorepo",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace @sorrel/frontend dev",
    "build": "yarn workspaces run build",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,html,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,html,yml,yaml}\"",
    "type-check": "yarn workspaces run type-check && tsc --noEmit -p tsconfig.json",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:check": "node scripts/codegen-check.mjs && graphql-codegen --config codegen.ts --check",
    "storyblok:types": "storyblok-generate-ts source=./storyblok.components.json target=./apps/web/types/storyblok.gen.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^7.1.2",
    "@graphql-codegen/typescript": "^6.0.2",
    "@graphql-codegen/typescript-resolvers": "^6.0.2",
    "@next/eslint-plugin-next": "^16.2.9",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.3",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "graphql": "^16.14.2",
    "jest": "^30.4.2",
    "prettier": "^3.8.4",
    "storyblok-generate-ts": "^2.2.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  }
}
